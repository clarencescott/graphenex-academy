rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userRecordPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function isAdmin() {
      return signedIn()
        && exists(userRecordPath(request.auth.uid))
        && get(userRecordPath(request.auth.uid)).data.get('admin', false) == true;
    }

    function isCompanyAdmin(companyId) {
      return signedIn()
        && exists(userRecordPath(request.auth.uid))
        && get(userRecordPath(request.auth.uid)).data.get('admin', false) == true
        && get(userRecordPath(request.auth.uid)).data.get('companyId', '') == companyId;
    }

    function accessPath() {
      return /databases/$(database)/documents/access/$(request.auth.uid);
    }

    function orgPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId);
    }

    function isUnexpired(data, field) {
      return data.get(field, timestamp.value(0)) > request.time;
    }

    function hasTrainingAccess() {
      let access = get(accessPath()).data;
      let orgId = access.get('orgId', '');
      return isUnexpired(access, 'trialEndsAt')
        || isUnexpired(access, 'paidUntil')
        || (orgId != '' && exists(orgPath(orgId)) && isUnexpired(get(orgPath(orgId)).data, 'paidUntil'));
    }

    // Paid individuals and members of a paid organization. Demo accounts are not included:
    // they get a limited course list from the server instead.
    function hasPaidAccess() {
      let access = get(accessPath()).data;
      let orgId = access.get('orgId', '');
      return isUnexpired(access, 'paidUntil')
        || (orgId != '' && exists(orgPath(orgId)) && isUnexpired(get(orgPath(orgId)).data, 'paidUntil'));
    }

    function uidMatchesPath(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function uidMatchesResource() {
      return signedIn() &&
        (
          resource.data.get('uid', '') == request.auth.uid ||
          resource.data.get('userId', '') == request.auth.uid
        );
    }

    function uidMatchesRequest() {
      return signedIn() &&
        (
          request.resource.data.get('uid', '') == request.auth.uid ||
          request.resource.data.get('userId', '') == request.auth.uid
        );
    }

    function requestKeepsUserIdentity() {
      return (
          !request.resource.data.keys().hasAny(['uid'])
          || request.resource.data.get('uid', '') == request.auth.uid
        )
        && (
          !request.resource.data.keys().hasAny(['userId'])
          || request.resource.data.get('userId', '') == request.auth.uid
        );
    }

    function userKeepsAdminAndCompany() {
      return request.resource.data.get('admin', false) == resource.data.get('admin', false)
        && request.resource.data.get('companyId', '') == resource.data.get('companyId', '');
    }

    match /profiles/{docId} {
      allow get: if isCompanyAdmin(resource.data.get('companyId', ''))
        || uidMatchesPath(docId)
        || uidMatchesResource();

      allow list: if isCompanyAdmin(resource.data.get('companyId', ''))
        || uidMatchesResource();

      allow create: if uidMatchesPath(docId)
        && uidMatchesRequest()
        && request.resource.data.get('admin', false) == false
        && request.resource.data.get('companyId', '') == '';

      allow update: if (
          isCompanyAdmin(resource.data.get('companyId', ''))
          && request.resource.data.get('companyId', '') == resource.data.get('companyId', '')
        )
        || (
          (uidMatchesPath(docId) || uidMatchesResource())
          && requestKeepsUserIdentity()
          && userKeepsAdminAndCompany()
        );

      allow delete: if false;
    }

    match /users/{docId} {
      allow get: if isCompanyAdmin(resource.data.get('companyId', ''))
        || uidMatchesPath(docId)
        || uidMatchesResource();

      allow list: if isCompanyAdmin(resource.data.get('companyId', ''))
        || uidMatchesResource();

      allow create: if uidMatchesPath(docId)
        && uidMatchesRequest()
        && request.resource.data.get('admin', false) == false
        && request.resource.data.get('companyId', '') == '';

      allow update: if (
          isCompanyAdmin(resource.data.get('companyId', ''))
          && request.resource.data.get('companyId', '') == resource.data.get('companyId', '')
        )
        || (
          (uidMatchesPath(docId) || uidMatchesResource())
          && requestKeepsUserIdentity()
          && userKeepsAdminAndCompany()
        );

      allow delete: if false;
    }

    match /courses/{courseId} {
      allow read: if signedIn() && exists(accessPath()) && hasPaidAccess();
      // Courses are shared by every organization, so they are edited from the Firebase console.
      allow create, update, delete: if false;
    }

    // Watch progress for course videos. Each learner can only read and write their own.
    match /videoProgress/{docId} {
      allow get: if signedIn() && docId.matches(request.auth.uid + '_.*');
      allow list: if signedIn() && resource.data.get('uid', '') == request.auth.uid;
      allow create, update: if signedIn()
        && docId.matches(request.auth.uid + '_.*')
        && request.resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.get('percent', -1) is number
        && exists(accessPath())
        && hasTrainingAccess();
      allow delete: if false;
    }

    // Demo and license records are written only by the server.
    match /access/{uid} {
      allow get: if uidMatchesPath(uid);
      allow list, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
